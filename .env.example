# =====================================================================
#  I-AMU environment template
#
#  Copy to `.env` and fill in real values. The .env file is loaded by
#  Docker Compose and (later) by the PHP app at boot.
# =====================================================================

# --- PostgreSQL (compose service "db") ---
DB_HOST=db
DB_PORT=5432
DB_NAME=IAMU_db
DB_USER=appIAMU
DB_PASSWORD=change-me

# --- Ollama (compose service "ollama2", internal port 11434) ---
OLLAMA_URL=http://ollama2:11434

# --- App ---
APP_DEBUG=true
